<%# locals: () %>
<%# Warns when the background worker that delivers AI responses is down or
    backed up. Operators can inspect the local worker. %>
<% if Current.user.ai_enabled? && !BackgroundJobHealth.healthy? %>
  <%= render DS::Alert.new(
    variant: "warning",
    message: t("chats.worker_unhealthy_warning"),
    live: :polite
  ) %>
<% end %>
