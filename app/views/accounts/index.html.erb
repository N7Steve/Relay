<%= content_for :page_title, t(".accounts") %>
<%= content_for :page_actions do %>
  <%= render "accounts/sync_controls", family: Current.family %>
  <%= render DS::Link.new(
    text: t(".new_account"),
    href: new_account_path(return_to: accounts_path),
    variant: "primary",
    icon: "plus",
    frame: :modal
  ) %>
<% end %>

<% if @manual_accounts.empty? && @financekit_accounts.empty? && @enable_banking_items.empty? %>
  <%= render "empty" %>
<% else %>
  <div class="space-y-2">
    <% if @financekit_accounts.any? %>
      <%= render "accounts/index/financekit_accounts", accounts: @financekit_accounts %>
    <% end %>
    <% if @enable_banking_items.any? %>
      <%= render @enable_banking_items.sort_by(&:created_at) %>
    <% end %>
    <div id="manual-accounts">
      <%= render "accounts/index/account_groups", accounts: @manual_accounts %>
    </div>
  </div>
<% end %>
