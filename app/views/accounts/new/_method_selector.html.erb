<%# locals: (path:, accountable_type:, provider_configs:) %>

<%= render layout: "accounts/new/container", locals: { title: t(".title"), back_path: new_account_path } do %>
  <div class="text-sm">
    <%# Manual entry option %>
    <%= link_to path, class: "group flex items-center gap-4 w-full text-center text-primary focus:outline-hidden focus:bg-surface-hover border border-transparent focus:border focus:border-secondary px-2 hover:bg-surface-hover rounded-lg p-2" do %>
      <span class="flex w-8 h-8 shrink-0 grow-0 items-center justify-center rounded-lg bg-container-inset shadow-border-xs">
        <%= icon("keyboard") %>
      </span>
      <%= t("accounts.new.method_selector.manual_entry") %>
      <%= icon("chevron-right", size: "sm", class: "ml-auto shrink-0 text-subdued transition-colors group-hover:text-secondary") %>
    <% end %>

    <%# Dynamic provider links. Admins may connect anything; a member may only
        connect providers whose credential is scoped to the single connection
        they authenticate (see ProviderItemOwnable). %>
    <% provider_configs.each do |config| %>
      <% next unless Current.user&.admin? || config[:member_connectable] %>
      <% link_path = config[:new_account_path].call(accountable_type, params[:return_to]) %>

      <%= link_to link_path,
                  class: "group text-primary flex items-center gap-4 w-full text-center focus:outline-hidden focus:bg-surface-hover border border-transparent focus:border focus:border-primary px-2 hover:bg-surface-hover rounded-lg p-2",
                  data: { turbo_frame: "modal", turbo_prefetch: "false" } do %>
        <span class="flex w-8 h-8 shrink-0 grow-0 items-center justify-center rounded-lg bg-container-inset shadow-border-xs">
          <%= icon("link-2") %>
        </span>
        <%= t("accounts.new.method_selector.link_with_provider", provider: config[:name]) %>

        <%= icon("chevron-right", size: "sm", class: "ml-auto shrink-0 text-subdued transition-colors group-hover:text-secondary") %>
      <% end %>
    <% end %>

  </div>
<% end %>
