<%# locals: (period:, legacy_data:) %>
<section id="cashflow-preview" class="mt-6 border-t border-primary pt-4 space-y-4 ph-no-capture group/sankey-preview"
  data-controller="sankey-preview"
  data-sankey-preview-legacy-data-value="<%= legacy_data.to_json %>"
  data-action="cash-flow:state->sankey-preview#update turbo:before-cache@document->sankey-preview#clear keydown->sankey-preview#stopKeydown">
  <header class="px-4 flex flex-wrap items-center justify-between gap-2">
    <div class="flex flex-wrap items-center gap-2">
      <h3 class="font-medium text-primary"><%= t("pages.dashboard.cashflow_preview.title") %></h3>
      <%= render DS::Pill.new(label: t("pages.dashboard.cashflow_preview.preview"), title: t("pages.dashboard.cashflow_preview.preview_tooltip")) %>
    </div>
    <%= render DS::Button.new(icon: "maximize-2", text: nil, variant: :ghost, disabled: true, aria: { label: t("global.expand") },
      data: { action: "sankey-preview#expand", sankey_preview_target: "expandButton" }) %>
  </header>
  <div data-controller="cash-flow" data-sankey-preview-target="display" class="ph-no-capture"
    data-action="turbo:before-cache@document->cash-flow#clear"
    data-cash-flow-url-value="<%= dashboard_cash_flow_path(start_date: period.start_date.iso8601, end_date: period.end_date.iso8601) %>">
    <p data-cash-flow-target="loading" role="status" class="p-4 text-secondary"><%= t("pages.dashboard.cashflow_sankey.loading") %></p>
    <div data-cash-flow-target="error" hidden role="alert" class="p-4 space-y-3">
      <p><%= t("pages.dashboard.cashflow_sankey.load_error") %></p>
      <%= render DS::Button.new(text: t("pages.dashboard.cashflow_sankey.retry"), data: { action: "cash-flow#load" }) %>
    </div>
    <div data-cash-flow-target="content" hidden>
      <div class="w-full h-96 overflow-x-auto overscroll-x-contain" tabindex="0" role="region" aria-label="<%= t("pages.dashboard.cashflow_preview.title") %>"><%= render "pages/dashboard/cashflow_preview_chart", period: period %></div>
      <%= render DS::Dialog.new(id: "cashflow-preview-expanded-dialog", auto_open: false, width: "expanded", disable_frame: true,
        data: { sankey_preview_target: "expandedDialog", action: "close->sankey-preview#restoreDrag" }) do |dialog| %>
        <% dialog.with_header(title: t("pages.dashboard.cashflow_preview.title")) %>
        <% dialog.with_body do %>
          <div class="w-full h-[85dvh] max-h-[90dvh] overflow-auto overscroll-contain" tabindex="0" role="region" aria-label="<%= t("pages.dashboard.cashflow_preview.title") %>">
            <%= render "pages/dashboard/cashflow_preview_chart", period: period %>
          </div>
        <% end %>
      <% end %>
    </div>
    <p data-cash-flow-target="empty" hidden class="p-4 text-secondary"><%= t("pages.dashboard.cashflow_sankey.no_data_title") %></p>
  </div>
</section>
