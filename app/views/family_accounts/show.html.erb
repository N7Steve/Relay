<%= content_for :page_title, t(".title") %>

<div class="space-y-6 pb-6 lg:pb-12">
  <header>
    <h1 class="text-2xl font-semibold text-primary"><%= t(".title") %></h1>
    <p class="text-sm text-secondary mt-1"><%= t(".subtitle") %></p>
  </header>

  <%= render DS::Card.new do %>
    <%= form_with url: family_accounts_path, method: :patch, data: { controller: "auto-submit-form", testid: "family-accounts-visibility" } do %>
      <div class="flex items-center justify-between gap-4">
        <div class="space-y-1">
          <p class="text-sm font-medium text-primary" id="show-family-accounts-label"><%= t(".visibility.label") %></p>
          <p class="text-sm text-secondary"><%= t(".visibility.description") %></p>
        </div>

        <%= render DS::Toggle.new(
              id: "show_family_accounts",
              name: "show_family_accounts",
              checked: Current.user.show_family_accounts?,
              "aria-labelledby": "show-family-accounts-label",
              data: { auto_submit_form_target: "auto" }
            ) %>
      </div>
    <% end %>
  <% end %>

  <%= render DS::Alert.new(message: t(".finances_notice"), variant: :info) %>

  <% if @members.empty? && @unowned_accounts.empty? %>
    <%= render DS::Card.new do %>
      <p class="text-sm text-secondary"><%= t(".empty") %></p>
    <% end %>
  <% else %>
    <% @members.each do |member| %>
      <%= render "family_accounts/member", name: member.display_name, role: member.role, accounts: @accounts_by_owner_id.fetch(member.id, []) %>
    <% end %>

    <% if @unowned_accounts.any? %>
      <%= render "family_accounts/member", name: t("family_accounts.unowned"), role: nil, accounts: @unowned_accounts %>
    <% end %>
  <% end %>
</div>
