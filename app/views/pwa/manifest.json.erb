<%# Relay icons use the supplied artwork. Regular and Apple icons fit within 72%
    of the canvas. Maskable artwork fits within 55%, so its corners remain
    inside the central 80% safe circle. All launcher icons have opaque backgrounds. %>
{
  "name": "<%= j product_name %>",
  "short_name": "<%= j product_name %>",
  "icons": [
    {
      "src": "/android-chrome-192x192.png?brand=relay-v3",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "/logo-pwa.png?brand=relay-v3",
      "type": "image/png",
      "sizes": "512x512"
    },
    {
      "src": "/logo-pwa-maskable.png?brand=relay-v3",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    }
  ],
  "start_url": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "minimal-ui"],
  "scope": "/",
  "orientation": "any",
  "description": "<%= j product_name %> is your personal finance assistant.",
  "theme_color": "#F9F9F9",
  "background_color": "#F9F9F9"
}
