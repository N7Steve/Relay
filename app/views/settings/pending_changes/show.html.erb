<% content_for :page_title, t("settings.pending_changes.title") %>

<%= render DS::Link.new(text: t(".back"), href: settings_pending_changes_path, icon: "arrow-left", variant: "ghost") %>

<%= settings_section(title: @change_set.credential_name, subtitle: l(@change_set.created_at, format: :long)) do %>
  <p class="text-primary font-medium"><%= t("settings.pending_changes.statuses.#{@change_set.status}") %></p>
  <p class="text-secondary text-sm mt-2"><%= t(".progress", applied: @change_set.overview[:applied], total: @change_set.operations.size) %></p>
<% end %>

<div class="space-y-2">
  <h2 class="text-primary font-medium"><%= t(".summary") %></h2>
  <p class="text-secondary text-sm"><%= t("settings.pending_changes.summary.amounts_notice") %></p>
</div>

<%= render DS::Table.new(rows: @summary.groups(@change_set), label: t(".summary")) do |table| %>
  <% table.with_column(t("settings.pending_changes.summary.changes"), class: "min-w-40") do |group| %>
    <p class="text-primary font-medium"><%= t("settings.pending_changes.types.#{group[:type]}", count: group[:count]) %></p>
    <p class="text-secondary text-sm"><%= t("settings.pending_changes.actions.#{group[:action]}") %></p>
  <% end %>
  <% table.with_column(t("settings.pending_changes.summary.context"), class: "min-w-56 privacy-sensitive") { |group| pending_change_context(group) } %>
  <% table.with_column(t("settings.pending_changes.summary.amount"), numeric: true, class: "privacy-sensitive") { |group| pending_change_amount(group) } %>
  <% table.with_column(t("settings.pending_changes.summary.state")) { |group| pending_change_states(group) } %>
<% end %>

<p class="text-secondary text-sm"><%= t("settings.pending_changes.details.notice") %></p>
<% @summary.groups(@change_set).each do |group| %>
  <%= render DS::Disclosure.new(title: "#{t("settings.pending_changes.actions.#{group[:action]}")} · #{t("settings.pending_changes.types.#{group[:type]}", count: group[:count])}", open: true) do %>
    <%= render DS::Table.new(rows: group[:details], label: t("settings.pending_changes.details.title")) do |table| %>
      <% table.with_column(t("settings.pending_changes.details.item"), class: "min-w-40 privacy-sensitive") do |detail| %>
        <p class="text-primary font-medium"><%= detail[:name] || t("settings.pending_changes.details.unnamed") %></p>
        <p class="text-secondary text-sm"><%= detail[:context].map { |value| pending_change_value(value) }.join(" · ") %></p>
        <% if detail[:changes].empty? %>
          <p class="text-secondary text-sm"><%= t("settings.pending_changes.details.unavailable") %></p>
        <% end %>
      <% end %>
      <% table.with_column(t("settings.pending_changes.details.before"), class: "min-w-56 privacy-sensitive") { |detail| pending_change_comparison(detail, :before) } %>
      <% table.with_column(t("settings.pending_changes.details.after"), class: "min-w-56 privacy-sensitive") { |detail| pending_change_comparison(detail, :after) } %>
      <% table.with_column(t("settings.pending_changes.summary.state")) do |detail| %>
        <%= t("settings.pending_changes.execution_states.#{detail[:state]}", count: 1) %>
        <% if detail[:error].present? %>
          <p class="text-destructive text-sm"><%= detail[:error] %></p>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if @change_set.status == "pending" %>
  <%= render DS::Alert.new(variant: :warning, message: t(".approval_notice")) %>
  <div class="flex flex-wrap gap-3">
    <%= render DS::Button.new(text: t(".approve"), href: approve_settings_pending_change_path(@change_set), method: :post,
          variant: "primary", params: { review_token: @change_set.review_token }, data: { turbo_confirm: t(".confirm") }) %>
    <%= render DS::Button.new(text: t(".reject"), href: reject_settings_pending_change_path(@change_set), method: :post,
          variant: "secondary", params: { review_token: @change_set.review_token }) %>
  </div>
<% elsif @change_set.status == "failed" %>
  <%= render DS::Alert.new(variant: :warning, message: t(".failure_notice")) %>
  <p class="text-secondary text-sm"><%= @change_set.overview.dig(:failure, "error_message") %></p>
  <%= render DS::Button.new(text: t(".discard_remaining"), href: reject_settings_pending_change_path(@change_set), method: :post,
        variant: "secondary", params: { review_token: @change_set.review_token }) %>
<% elsif @change_set.status.in?(%w[approved applying]) %>
  <%= render DS::Alert.new(message: t(".processing_notice")) %>
<% end %>
