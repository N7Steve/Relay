<% content_for :page_title, t("settings.pending_changes.title") %>

<%= render DS::Alert.new(message: t("settings.pending_changes.description")) %>

<% if @change_sets.empty? %>
  <%= settings_section(title: t(".empty_title"), subtitle: t(".empty_description")) do %>
    <%= icon "list-checks", class: "text-secondary" %>
  <% end %>
<% else %>
  <%= render DS::Table.new(rows: @change_sets, label: t("settings.pending_changes.title")) do |table| %>
    <% table.with_column(t(".proposal")) do |change_set| %>
      <%= link_to l(change_set.created_at, format: :short), settings_pending_change_path(change_set), class: "text-primary underline" %>
      <p class="text-secondary text-sm"><%= change_set.credential_name %></p>
    <% end %>
    <% table.with_column(t(".summary")) do |change_set| %>
      <%= t("settings.pending_changes.operation_count", count: change_set.operations.size) %>
    <% end %>
    <% table.with_column(t(".status")) do |change_set| %>
      <%= t("settings.pending_changes.statuses.#{change_set.status}") %>
    <% end %>
  <% end %>
<% end %>
