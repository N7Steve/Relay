<%= content_for :page_title, t(".title") %>
<%= settings_section title: t(".general"), collapsible: true do %>
  <div class="space-y-6">
    <%= render "settings/hostings/brand_fetch_settings" %>
  </div>
<% end %>
<%= settings_section title: t(".property_valuation_providers"), collapsible: true do %>
  <div class="space-y-6">
    <%= render "settings/hostings/rentcast_settings" %>
    <%= render "settings/hostings/realie_settings" %>
  </div>
<% end %>
<%= settings_section title: t(".sync_settings"), collapsible: true do %>
  <%= render "settings/hostings/sync_settings" %>
<% end %>
<% if Current.user.super_admin? %>
  <%= settings_section title: t(".invites"), collapsible: true do %>
    <%= render "settings/hostings/invite_code_settings" %>
  <% end %>
<% end %>
<% if Current.user.super_admin? %>
  <%= settings_section title: t(".demo_refresh") do %>
    <%= render "settings/hostings/demo_refresh_settings" %>
  <% end %>
<% end %>
<%= settings_section title: t(".danger_zone"), collapsible: true, open: false do %>
  <%= render "settings/hostings/danger_zone_settings" %>
<% end %>
