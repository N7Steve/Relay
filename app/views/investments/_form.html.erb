<%# locals: (account:, url:) %>

<%= render "accounts/form", account: account, url: url do |form| %>
  <%= form.select :subtype,
                 grouped_options_for_select(Investment.subtypes_grouped_for_select(current_subtype: account.accountable&.subtype || account.subtype), account.accountable&.subtype || account.subtype),
                 { label: true, prompt: t("investments.form.subtype_prompt"), include_blank: t("investments.form.none") } %>
  <%= form.fields_for :accountable do |accountable_form| %>
  <%= accountable_form.select :tax_treatment,
                 Investment::TAX_TREATMENTS.map { |value| [t("investments.form.tax_treatments.#{value}"), value] },
                 { label: t("investments.form.tax_treatment"), selected: account.accountable.tax_treatment } %>
  <%= accountable_form.select :tracking_mode,
                 Investment::TRACKING_MODES.map { |value| [t("investments.form.tracking_modes.#{value}"), value] },
                 { label: t("investments.form.tracking_mode"), include_blank: t("investments.form.keep_tracking"), selected: account.accountable.tracking_mode } %>
  <% end %>
<% end %>
