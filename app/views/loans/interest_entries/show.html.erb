<%# The detail of a posted interest entry: read-only, and how it was worked
    out. A figure that differs from the lender's is corrected at its source
    (the revision's rate, or the movements), not here. %>
<% detail = @entry.transaction.extra&.dig("loan_interest") || {} %>
<% account = @entry.account %>
<%= render DS::Dialog.new(frame: "drawer", responsive: true) do |dialog| %>
  <% dialog.with_header(title: @entry.name) %>
  <% dialog.with_body do %>
    <div class="space-y-4 p-4">
      <p class="text-2xl font-medium text-primary privacy-sensitive"><%= format_money(@entry.amount_money) %></p>
      <p class="text-sm text-secondary"><%= t(".locked") %></p>

      <% if detail.present? %>
        <%= render DS::Card.new(class: "text-sm") do %>
          <dl class="space-y-2">
            <%= render DS::DetailRow.new(label: t(".period"),
                  value: t("loans.interest_entries.row.period", from: l(Date.iso8601(detail["from"]), format: :long), to: l(Date.iso8601(detail["to"]), format: :long))) %>
            <%= render DS::DetailRow.new(label: t(".days"), value: detail["days"].to_s) %>
            <%= render DS::DetailRow.new(label: t(".average_balance"), value_class: "privacy-sensitive",
                  value: format_money(Money.new(BigDecimal(detail["average_balance"]), account.currency))) %>
            <%= render DS::DetailRow.new(label: t(".rates")) do |row| %>
              <% row.with_value do %>
                <% Array(detail["rates"]).each do |from, rate| %>
                  <div><%= t(".rate_from", rate: loan_rate_percentage(BigDecimal(rate)), date: l(Date.iso8601(from), format: :long)) %></div>
                <% end %>
              <% end %>
            <% end %>
            <%= render DS::DetailRow.new(label: t(".method"), value: t(".methods.#{detail['accrual']}", default: detail["accrual"].to_s)) %>
          </dl>
        <% end %>
        <p class="text-xs text-secondary"><%= t(".formula_#{detail['accrual'] == 'monthly' ? 'monthly' : 'daily'}") %></p>
      <% end %>

      <%= render DS::Link.new(text: t(".open_rates"), icon: "percent", variant: "secondary",
                              href: account_path(account, tab: "rates"), data: { turbo_frame: "_top" }) %>
    </div>
  <% end %>
<% end %>
