<%# locals: (title:, content:, subtitle: nil, icon: nil, actions: nil, class_name: nil) %>
<%# One block of a loan tab: a card with its heading, an optional line under
    it and its actions on the right, so every tab reads as the same set of
    titled cards. Rendered through LoansHelper#loan_section, which captures the
    body in the calling view so its lazy translations keep their scope. %>
<%= render DS::Card.new(class: class_names("gap-4 min-w-0", class_name)) do %>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="flex items-start gap-3 min-w-0">
      <% if icon %>
        <%= render DS::FilledIcon.new(icon: icon, variant: :surface, size: "md", rounded: true) %>
      <% end %>
      <div class="min-w-0">
        <h3 class="text-base font-medium text-primary"><%= title %></h3>
        <% if subtitle.present? %>
          <p class="text-xs text-secondary mt-0.5"><%= subtitle %></p>
        <% end %>
      </div>
    </div>
    <% if actions.present? %>
      <div class="flex flex-wrap items-center gap-1 shrink-0"><%= actions %></div>
    <% end %>
  </div>
  <%= content %>
<% end %>
