<%# locals: (account:, can_edit:) %>

<%# How money reaches this loan. A contract-managed loan's account takes only
    the instalment its Agenda series pays, the prepayments recorded below and
    the interest it posts; anything else found on it is listed for removal. %>
<% loan = account.loan %>
<% series = loan.instalment_series %>

<section class="space-y-2">
  <div class="flex items-center justify-between gap-2">
    <h3 class="font-medium text-primary"><%= t(".title") %></h3>
    <% if can_edit && series.nil? %>
      <%= render DS::Link.new(text: t(".link"), icon: "repeat", variant: "ghost", size: "sm",
                              href: new_loan_instalment_series_path(account), frame: :modal) %>
    <% end %>
  </div>

  <% if loan.contract_managed? %>
    <p class="text-xs text-secondary"><%= t(".closed") %></p>
  <% end %>

  <% if series %>
    <%= render DS::Card.new(class: "space-y-1") do %>
      <p class="text-sm font-medium text-primary"><%= series.title %></p>
      <p class="text-sm text-secondary">
        <%= t(".series_detail", account: series.account.name, date: l(series.next_run_date, format: :long),
                                amount: format_money(Money.new(series.amount_for(series.next_run_date), series.currency))) %>
      </p>
      <p class="text-xs text-secondary"><%= t(".series_owned") %></p>
    <% end %>
  <% else %>
    <%= render DS::Alert.new(message: t(".no_series"), variant: (loan.contract_managed? ? :warning : :info)) %>
  <% end %>

  <% if loan.contract_managed? %>
    <% foreign = loan.foreign_entries.includes(:entryable).to_a %>
    <% if foreign.any? %>
      <%= render DS::Alert.new(title: t(".foreign_title"), message: t(".foreign_message"), variant: :warning) %>
      <%= render DS::Table.new(rows: foreign, label: t(".foreign_title")) do |table| %>
        <% table.with_column(t(".columns.date")) { |entry| l(entry.date, format: :long) } %>
        <% table.with_column(t(".columns.name")) { |entry| entry.name } %>
        <% table.with_column(t(".columns.amount"), numeric: true, class: "privacy-sensitive") { |entry| format_money(entry.amount_money) } %>
        <% table.with_column("", numeric: true) do |entry| %>
          <% if can_edit %>
            <%= render DS::Button.new(
                  text: t(".remove"), variant: "ghost", size: "sm",
                  href: entry.valuation? ? valuation_path(entry) : transaction_path(entry), method: :delete,
                  confirm: CustomConfirm.new(title: t(".remove_confirm_title"), body: t(".remove_confirm_body"), btn_text: t(".remove"))
                ) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</section>
