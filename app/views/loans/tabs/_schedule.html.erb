<%# locals: (account:, projection:, as_of: Date.current) %>

<%# `as_of` is the page's one reference date: the chart above the tabs and
    this table shade "past" against the same day. `projection` is the loan's
    payoff projection for that date, built once for the page and shared with
    the chart. %>
<% today = as_of %>
<% schedule = account.loan.amortization_schedule %>
<% payments = schedule.payments %>
<% paid_count = payments.count { |payment| payment.date <= today } %>
<% next_payment = payments.find { |payment| payment.date > today } %>

<div class="space-y-4">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
    <%# Where the borrower is in the schedule. %>
    <%= render DS::Card.new(class: "justify-center") do %>
      <div class="flex items-center gap-4">
        <%= render DS::ProgressRing.new(percent: payments.any? ? (paid_count * 100.0 / payments.size).round : 0, size: 80, stroke_width: 8,
                                        tone: :success, label: t(".progress_label")) %>
        <div class="min-w-0 space-y-0.5">
          <p class="text-sm text-secondary"><%= t(".progress_label") %></p>
          <p class="text-xl font-semibold text-primary tabular-nums"><%= t(".progress", paid: paid_count, total: payments.size) %></p>
          <% if next_payment %>
            <p class="text-xs text-secondary privacy-sensitive">
              <%= t(".next_payment", date: l(next_payment.date, format: :long), amount: format_money(next_payment.payment)) %>
            </p>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="lg:col-span-2 grid grid-cols-2 gap-2">
      <%# A re-amortising loan has no single monthly payment, so the card says
          which one this is rather than implying the figure holds for the term. %>
      <%= summary_card title: schedule.re_amortising? ? t(".opening_payment") : t(".monthly_payment") do %>
        <%= format_money schedule.periodic_payment %>
      <% end %>

      <%= summary_card title: t(".total_interest") do %>
        <%= format_money schedule.total_interest %>
      <% end %>

      <%= summary_card title: t(".total_cost") do %>
        <%= format_money schedule.total_paid %>
      <% end %>

      <%# When the loan will actually be paid off: the projection from today's
          balance at the contract's repayment, as the chart above draws it. The
          Overview tab has the contract's own date. A balance that repayment no
          longer clears has no date to give. %>
      <%= summary_card title: t(".forecasted_payoff_date") do %>
        <% if projection.payoff_date %>
          <%= l projection.payoff_date, format: :long %>
        <% elsif projection.applicable? %>
          <%= t(".forecasted_payoff_not_converged") %>
        <% else %>
          <%= t(".not_applicable") %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% subtitle = capture do %>
    <%= t(".description", start_date: l(account.loan.origination_date, format: :long)) %>
    <% if account.loan.variable_rate_type? %>
      <%= t(".variable_rate_notice") %>
    <% end %>
  <% end %>
  <%= loan_section(title: t("accounts.show.tabs.schedule"), subtitle: subtitle, icon: "table-2") do %>
    <div class="flex flex-wrap items-center gap-3 text-xs text-secondary">
      <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-container-inset border border-primary"></span><%= t(".legend_paid") %></span>
      <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-success/20 border border-primary"></span><%= t(".legend_next") %></span>
    </div>

    <%= render DS::Table.new(
          rows: payments,
          sticky_header: true,
          inset: true,
          label: t("accounts.show.tabs.schedule"),
          row_class: ->(payment) {
            if payment.date <= today
              "bg-container-inset text-secondary"
            elsif payment.equal?(next_payment)
              "bg-success/10 font-medium"
            end
          }
        ) do |table| %>
      <% table.with_column(t(".number"), class: "text-secondary tabular-nums") { |payment| payment.number.to_s } %>
      <% table.with_column(t(".date")) { |payment| l(payment.date, format: :long) } %>
      <% table.with_column(t(".payment"), numeric: true, class: "privacy-sensitive") { |payment| format_money(payment.payment) } %>
      <% table.with_column(t(".principal"), numeric: true, class: "privacy-sensitive") { |payment| format_money(payment.principal) } %>
      <% table.with_column(t(".interest"), numeric: true, class: "text-secondary privacy-sensitive") { |payment| format_money(payment.interest) } %>
      <% if payments.any? { |payment| payment.prepayment.amount.positive? } %>
        <% table.with_column(t(".prepayment"), numeric: true, class: "privacy-sensitive") do |payment| %>
          <%= payment.prepayment.amount.positive? ? format_money(payment.prepayment) : "" %>
        <% end %>
      <% end %>
      <% table.with_column(t(".remaining_balance"), numeric: true, class: "privacy-sensitive") { |payment| format_money(payment.ending_balance) } %>
    <% end %>
  <% end %>
</div>
