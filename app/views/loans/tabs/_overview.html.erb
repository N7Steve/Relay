<%# locals: (account:, as_of: Date.current) %>

<%# ONE reference date for every figure on this tab, supplied by the caller
    where it has one (the account page passes the same date to the Schedule
    tab). %>
<% today = as_of %>
<% loan = account.loan %>
<% schedule = loan.amortization_schedule %>

<div class="space-y-4">
  <%= render "loans/tabs/repayment_progress", loan: loan, as_of: today %>

  <%= loan_section(title: t(".terms_title"), subtitle: t(".terms_subtitle"), icon: "file-text") do %>
    <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-2">
      <%= render "loans/stat", title: t(".original_principal"), value: format_money(loan.original_balance) %>

      <%# The rate in force today, not the one the loan was written at. On a
          variable loan with a recorded change the Schedule tab re-amortises
          at that change; quoting `interest_rate` here showed the origination
          rate next to a schedule that no longer used it. %>
      <% current_rate = loan.current_variable_rate(today) %>
      <%= render "loans/stat", title: t(".interest_rate"),
                               value: current_rate.present? ? number_to_percentage(current_rate, precision: 3) : t(".unknown") %>

      <%# A fixed loan's contracted repayment. A variable loan has no single
          one, so this is the repayment in force today -- the next scheduled
          payment, sized at every rate change recorded before it. %>
      <% monthly_payment = if loan.variable_rate_type?
           payment_in_force = schedule&.payment_in_force(today)
           payment_in_force ? format_money(payment_in_force) : t(".not_applicable")
         elsif loan.monthly_payment.present?
           format_money(loan.monthly_payment)
         else
           t(".unknown")
         end %>
      <%= render "loans/stat", title: t(".monthly_payment"), value: monthly_payment %>

      <% term = if loan.term_months.blank?
           t(".unknown")
         elsif loan.term_months < 12 || (loan.term_months % 12).nonzero?
           t(".term_months", count: loan.term_months)
         else
           t(".term_years", count: loan.term_months / 12)
         end %>
      <%= render "loans/stat", title: t(".term"), value: term %>

      <%# When the contract's last payment falls due. A variable loan keeps
          this date through its rate changes -- the schedule resizes the
          repayment instead. %>
      <% original_payoff_date = schedule&.payoff_date %>
      <%= render "loans/stat", title: t(".original_payoff_date"),
                               value: original_payoff_date ? l(original_payoff_date, format: :long) : t(".unknown") %>

      <%= render "loans/stat", title: t(".type"),
                               value: loan.rate_type.present? ? t("loans.form.rate_type_#{loan.rate_type}", default: loan.rate_type.titleize) : t(".unknown") %>

      <%# What the loan costs in total: the Schedule tab's "Total Cost"
          (principal and interest) plus any premium charged beside it. With a
          premium the title says so, because both tabs render on one page and
          the same title over two different amounts reads as a mistake. %>
      <% total_cost = loan.total_cost %>
      <%= render "loans/stat", title: loan.insurance.present? ? t(".total_cost_with_insurance") : t(".total_cost"),
                               value: total_cost ? format_money(total_cost) : t(".unknown") %>

      <%# Only for a loan carrying a premium. A card reading zero would say the
          borrower has insurance costing nothing rather than none recorded. %>
      <% if loan.insurance.present? %>
        <%= render "loans/stat", title: t(".total_insurance"), value: format_money(loan.total_insurance) %>
      <% elsif loan.insurance_rate&.positive? %>
        <%= render "loans/stat", title: t(".total_insurance"),
                                 value: t(".insurance_rate_only", rate: number_to_percentage(loan.insurance_rate, strip_insignificant_zeros: true)) %>
      <% end %>

      <%# Leverage needs a down payment to be a ratio at all, and a loan with
          none recorded is not unleveraged -- it is one nobody has told us
          about. %>
      <% if loan.initial_leverage_ratio.present? %>
        <%= render "loans/stat", title: t(".leverage"), value_class: loan_leverage_band_class(loan.leverage_band),
                                 value: t(".leverage_multiple", ratio: number_with_precision(loan.initial_leverage_ratio, precision: 1)),
                                 hint: t(".leverage_band_#{loan.leverage_band}") %>
      <% end %>
    </div>
  <% end %>

  <div class="flex justify-center py-4">
    <%= render DS::Link.new(
      text: t(".edit_loan_details"),
      icon: "pencil",
      variant: "ghost",
      href: edit_loan_path(account),
      frame: :modal
    ) %>
  </div>
</div>
